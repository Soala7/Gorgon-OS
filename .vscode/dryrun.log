make --dry-run --always-make --keep-going --print-directory
make: Entering directory '/home/s7k11/Documents/Gorgon-OS'
mkdir -p build/x86_64/ && \
x86_64-elf-gcc -c -ffreestanding src/kernel/main.c -o build/x86_64/main.o
mkdir -p build/x86_64/ && \
x86_64-elf-gcc -c -ffreestanding src/kernel/serial.c -o build/x86_64/serial.o
mkdir -p build/x86_64/boot/ && \
nasm -f elf64 src/x86_64/boot/main.asm -o build/x86_64/boot/main.o
mkdir -p build/x86_64/boot/ && \
nasm -f elf64 src/x86_64/boot/header.asm -o build/x86_64/boot/header.o
mkdir -p build/x86_64/boot/ && \
nasm -f elf64 src/x86_64/boot/main64.asm -o build/x86_64/boot/main64.o
mkdir -p dist/x86_64
# Link all object files into the kernel
x86_64-elf-ld -n \
	-o dist/x86_64/kernel.bin \
	-T targets/x86_64/linker.ld \
	build/x86_64/main.o build/x86_64/serial.o \
	 build/x86_64/boot/main.o build/x86_64/boot/header.o build/x86_64/boot/main64.o
# Copy kernel into the ISO
cp dist/x86_64/kernel.bin targets/x86_64/iso/boot/kernel.bin
# Create bootable ISO
grub-mkrescue \
	-o dist/x86_64/gorgon.iso \
	targets/x86_64/iso
