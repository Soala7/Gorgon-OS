{
    "tasks": [
        {
            "type": "shell",
            "label": "Check Gorgon OS (WSL)",
            "command": "wsl.exe",
            "args": [
                "--exec",
                "make",
                "check"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile and link all kernel C and NASM sources with the x86_64-elf toolchain."
        }
    ],
    "version": "2.0.0"
}